# Not needed for local dev -- lib/api.ts falls back to http://localhost:8000,
# which matches the default `uvicorn` backend port.
#
# Required if you deploy this frontend as a hosted web app (Vercel, a
# Dockerized `next start`, etc.) talking to a backend that ISN'T on the same
# machine as the visitor's browser. NEXT_PUBLIC_* vars are inlined into the
# client bundle at `next build` time, so this must be set before building,
# not just at runtime -- otherwise every visitor's browser tries to reach
# their own localhost:8000 and every API call fails silently.
NEXT_PUBLIC_API_BASE=https://api.your-deployed-backend.example.com

# Not needed for local dev either -- when these are unset, middleware.ts
# doesn't gate any routes and AuthButton renders nothing, same "local, no
# accounts" mode the backend defaults to. Set both together with the
# backend's PLASMA_SPEC_STORAGE_BACKEND=supabase to turn on Google sign-in
# and cross-device persistence. From your Supabase project's Settings -> API
# (run supabase/schema.sql in the SQL editor first, and enable the Google
# provider under Authentication -> Providers).
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
