# Not needed for local dev -- with PLASMA_SPEC_STORAGE_BACKEND unset (or
# "local"), the backend uses local SQLite + local files, no auth required,
# exactly like before Supabase support existed. This is also what the
# pytest suite runs against.

# Set to "supabase" to require Google-authenticated requests and persist to
# a Supabase project instead of local storage.
# PLASMA_SPEC_STORAGE_BACKEND=supabase

# Required when PLASMA_SPEC_STORAGE_BACKEND=supabase. From your Supabase
# project's Settings -> API. Run supabase/schema.sql in the SQL editor first.
# SUPABASE_ANON_KEY is the "Publishable key" on newer projects (the old
# anon/service_role key naming still works too).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional. Tokens are verified against the project's public JWKS
# (Settings -> API -> JWT Keys) by default -- no secret needed for that.
# Only set this if your project is still on (or mid-migration off of) the
# legacy shared HS256 secret (Settings -> API -> JWT Keys -> Legacy JWT
# Secret); it's a real secret, treat it like a password.
# SUPABASE_JWT_SECRET=your-legacy-jwt-secret
